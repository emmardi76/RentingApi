{
  "info": {
    "name": "Renting API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Vehicle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var vehicleId = pm.response.json();",
              "pm.environment.set('vehicleId', vehicleId);",
              "console.log('VehicleId saved: ' + vehicleId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"make\": \"Toyota\",\n    \"model\": \"Corolla\",\n    \"year\": 2023\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/vehicles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "vehicles"]
        }
      }
    },
    {
      "name": "Create Rental",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var rentalId = pm.response.json();",
              "pm.environment.set('rentalId', rentalId);",
              "console.log('RentalId saved: ' + rentalId);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generar fecha UTC actual",
              "var now = new Date();",
              "var utcDate = now.toISOString();",
              "pm.environment.set('startDate', utcDate);",
              "console.log('StartDate UTC: ' + utcDate);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"vehicleId\": \"{{vehicleId}}\",\n    \"customerId\": \"customer-001\",\n    \"startDate\": \"{{startDate}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/rentals",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rentals"]
        }
      }
    },
    {
      "name": "Return Vehicle",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/return",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rentals", "{{rentalId}}", "return"]
        }
      }
    },
    {
      "name": "Get Available Vehicles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/vehicles/available",
          "host": ["{{baseUrl}}"],
          "path": ["api", "vehicles", "available"]
        }
      }
    }
  ]
}
